{
    "name": "rouxtaccess/laravel-cloudwatch",
    "description": "Ship Laravel logs to AWS CloudWatch Logs through a non-blocking, cache-buffered log channel",
    "keywords": [
        "RouxtAccess",
        "laravel",
        "laravel-cloudwatch",
        "cloudwatch",
        "logging",
        "monolog"
    ],
    "homepage": "https://github.com/rouxtaccess/laravel-cloudwatch",
    "license": "MIT",
    "authors": [
        {
            "name": "John Roux",
            "email": "john.roux1@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "aws/aws-sdk-php": "^3.300",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "monolog/monolog": "^3.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0.0||^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Rouxtaccess\\CloudWatch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rouxtaccess\\CloudWatch\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rouxtaccess\\CloudWatch\\CloudWatchServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
